NEXT_PUBLIC_SITE_URL=http://localhost:3000

# cPanel MySQL database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=cpaneluser_apkmarket
DB_USER=cpaneluser_apkuser
DB_PASSWORD=CHANGE_DATABASE_PASSWORD

# File uploads. For cPanel, use an absolute writable path if you want uploads outside the Git repo.
# Example: /home/CPANELUSER/apkmarket_uploads
UPLOAD_DIR=
# Public URL that maps to UPLOAD_DIR. Leave /uploads when using public/uploads locally.
UPLOAD_PUBLIC_URL=/uploads

# CMS login
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_THIS_PASSWORD
ADMIN_SESSION_SECRET=CHANGE_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS

# Encrypts SMTP app passwords saved in CMS. Generate with: openssl rand -hex 32
ENCRYPTION_KEY=
